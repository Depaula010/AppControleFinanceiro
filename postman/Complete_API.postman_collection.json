		{
			"name": "🔐 Segurança",
			"item": [
				{
					"name": "Ver Estatísticas de Segurança",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "x-api-key",
								"value": "{{API_SECRET_KEY}}",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{BASE_URL}}/admin/security-stats",
							"host": ["{{BASE_URL}}"],
							"path": ["admin", "security-stats"]
						},
						"description": "Retorna:\n- IPs na blacklist permanente\n- IPs bloqueados temporariamente\n- Atividade suspeita recente"
					}
				},
				{
					"name": "Adicionar IP à Blacklist",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "x-api-key",
								"value": "{{API_SECRET_KEY}}",
								"type": "text"
							},
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"ip\": \"192.168.1.100\",\n    \"reason\": \"Tentativas repetidas de invasão\"\n}"
						},
						"url": {
							"raw": "{{BASE_URL}}/admin/security-blacklist-add",
							"host": ["{{BASE_URL}}"],
							"path": ["admin", "security-blacklist-add"]
						},
						"description": "Bloqueia um IP permanentemente (1 ano)"
					}
				},
				{
					"name": "Remover IP da Blacklist",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "x-api-key",
								"value": "{{API_SECRET_KEY}}",
								"type": "text"
							},
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"ip\": \"172.19.0.6\"\n}"
						},
						"url": {
							"raw": "{{BASE_URL}}/admin/security-blacklist-remove",
							"host": ["{{BASE_URL}}"],
							"path": ["admin", "security-blacklist-remove"]
						},
						"description": "Remove um IP da blacklist permanente"
					}
				}
			]
		},
