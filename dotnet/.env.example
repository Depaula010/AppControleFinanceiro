# Mesmos nomes dos secrets do GitHub / .env do servidor. Copie para .env (não versionado)
# ou use `dotnet user-secrets`. Nunca commite valores reais.

# Obrigatórias
DATABASE_URL=postgresql://usuario:senha-com-url-encoding@localhost:5432/bot_whatsapp_homol
API_SECRET_KEY=troque-por-uma-chave-com-no-minimo-32-caracteres
ENCRYPTION_KEY=chave-fernet-base64-urlsafe-de-32-bytes
GEMINI_API_KEY=
REDIS_URL=redis://localhost:6379

# Opcionais
WEBHOOK_SIGNATURE_KEY=
BOT_WHATSAPP_URL=
BOT_SESSION_NAME=sessao-principal
BOT_SESSION_ID=
BOT_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
WEATHER_API_KEY=
OPENROUTE_API_KEY=
OPENROUTE_BASE_URL=https://api.openrouteservice.org
TRAVEL_TIME_DAILY_LIMIT=10

# Só do .NET
LOG_DIR=logs
LOG_TO_FILE=true
