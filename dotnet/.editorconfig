root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4

[*.{csproj,props,slnx,json,yml,yaml}]
indent_size = 2

# Testes usam Metodo_Cenario_Resultado (specs/foundation/testing-strategy.md).
[tests/**.cs]
dotnet_diagnostic.CA1707.severity = none
