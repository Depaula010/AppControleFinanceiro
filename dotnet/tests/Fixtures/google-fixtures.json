    "already_connected": "\n            <!DOCTYPE html>\n            <html>\n            <head>\n                <title>Ja Conectado</title>\n                <meta charset=\"utf-8\">\n                <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n                <style>\n                    body {\n                        font-family: Arial, sans-serif;\n                        text-align: center;\n                        padding: 50px;\n                        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);\n                        color: white;\n                    }\n                    .container {\n                        background: white;\n                        color: #333;\n                        padding: 40px;\n                        border-radius: 15px;\n                        max-width: 500px;\n                        margin: 0 auto;\n                        box-shadow: 0 10px 30px rgba(0,0,0,0.3);\n                    }\n                    .icon { font-size: 64px; margin-bottom: 20px; }\n                    h1 { color: #667eea; margin-bottom: 20px; }\n                </style>\n            </head>\n            <body>\n                <div class=\"container\">\n                    <div class=\"icon\">OK</div>\n                    <h1>Voce ja esta conectado!</h1>\n                    <p>Seu Google Calendar e Google Drive ja estao integrados.</p>\n                    <p>Volte para o WhatsApp e use:</p>\n                    <p><strong>\"Tenho compromisso hoje?\"</strong></p>\n                    <p><strong>\"Salvar no drive pasta X\"</strong> (envie com uma imagem)</p>\n                </div>\n            </body>\n            </html>\n            ",
    "denied": "\n            <!DOCTYPE html>\n            <html>\n            <head>\n                <title>Autorizacao Negada</title>\n                <meta charset=\"utf-8\">\n                <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n                <style>\n                    body {\n                        font-family: Arial, sans-serif;\n                        text-align: center;\n                        padding: 50px;\n                        background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);\n                        color: white;\n                    }\n                    .container {\n                        background: white;\n                        color: #333;\n                        padding: 40px;\n                        border-radius: 15px;\n                        max-width: 500px;\n                        margin: 0 auto;\n                        box-shadow: 0 10px 30px rgba(0,0,0,0.3);\n                    }\n                    .icon { font-size: 64px; margin-bottom: 20px; }\n                    h1 { color: #f5576c; margin-bottom: 20px; }\n                </style>\n            </head>\n            <body>\n                <div class=\"container\">\n                    <div class=\"icon\">X</div>\n                    <h1>Autorizacao Negada</h1>\n                    <p>Voce negou o acesso ao Google Calendar.</p>\n                    <p>Para usar esta funcionalidade, voce precisa autorizar o acesso.</p>\n                    <p>Tente novamente quando quiser!</p>\n                </div>\n            </body>\n            </html>\n            ",
    "connected": "\n        <!DOCTYPE html>\n        <html>\n        <head>\n            <title>Conexao Autorizada</title>\n            <meta charset=\"utf-8\">\n            <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n            <style>\n                body {\n                    font-family: Arial, sans-serif;\n                    text-align: center;\n                    padding: 50px;\n                    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);\n                    color: white;\n                }\n                .container {\n                    background: white;\n                    color: #333;\n                    padding: 40px;\n                    border-radius: 15px;\n                    max-width: 500px;\n                    margin: 0 auto;\n                    box-shadow: 0 10px 30px rgba(0,0,0,0.3);\n                    animation: slideIn 0.5s ease-out;\n                }\n                @keyframes slideIn {\n                    from { transform: translateY(-50px); opacity: 0; }\n                    to { transform: translateY(0); opacity: 1; }\n                }\n                .icon {\n                    font-size: 80px;\n                    margin-bottom: 20px;\n                    animation: bounce 1s infinite;\n                }\n                @keyframes bounce {\n                    0%, 100% { transform: translateY(0); }\n                    50% { transform: translateY(-10px); }\n                }\n                h1 {\n                    color: #667eea;\n                    margin-bottom: 20px;\n                    font-size: 28px;\n                }\n                .success { color: #10b981; font-weight: bold; }\n                .info {\n                    background: #f0f9ff;\n                    padding: 20px;\n                    border-radius: 10px;\n                    margin: 20px 0;\n                    border-left: 4px solid #667eea;\n                }\n                .commands {\n                    text-align: left;\n                    margin: 20px 0;\n                }\n                .command {\n                    background: #f9fafb;\n                    padding: 10px;\n                    margin: 8px 0;\n                    border-radius: 5px;\n                    border-left: 3px solid #10b981;\n                }\n                .footer {\n                    margin-top: 30px;\n                    font-size: 14px;\n                    color: #6b7280;\n                }\n            </style>\n        </head>\n        <body>\n            <div class=\"container\">\n                <div class=\"icon\">OK</div>\n                <h1 class=\"success\">Google Calendar + Drive Conectados!</h1>\n                <p>Ola <strong>{nome}</strong>!</p>\n                <p>Sua conta Google foi conectada com sucesso.</p>\n\n                <div class=\"info\">\n                    <h3 style=\"margin-top: 0; color: #667eea;\">Calendario:</h3>\n                    <div class=\"commands\">\n                        <div class=\"command\">- \"Tenho compromisso hoje?\"</div>\n                        <div class=\"command\">- \"Minha agenda amanha\"</div>\n                        <div class=\"command\">- \"Compromissos do final de semana\"</div>\n                    </div>\n                    <h3 style=\"color: #667eea;\">Google Drive:</h3>\n                    <div class=\"commands\">\n                        <div class=\"command\">- Envie uma imagem com: \"salvar no drive pasta X\"</div>\n                        <div class=\"command\">- Envie um PDF com: \"guardar no drive\"</div>\n                    </div>\n                </div>\n\n                <div class=\"footer\">\n                    <p>Voce ja pode fechar esta janela</p>\n                    <p>Volte para o WhatsApp!</p>\n                    <p style=\"margin-top: 20px;\">\n                        <small>Conexao segura via OAuth2 oficial do Google</small>\n                    </p>\n                </div>\n            </div>\n        </body>\n        </html>\n        ",
