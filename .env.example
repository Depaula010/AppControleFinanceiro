# Meu Secretário (.NET 10): modelo de variáveis de ambiente.
# Copie para .env (NUNCA versionar) ou use `dotnet user-secrets`. Em produção os valores vêm dos secrets do GitHub (deploy.yml).

# --- Obrigatórias ---
DATABASE_URL=postgresql://usuario:senha@host:5432/banco
API_SECRET_KEY=            # >= 32 caracteres; JWT (HS256), x-api-key de /admin e do webhook
ENCRYPTION_KEY=            # chave Fernet (base64 url-safe de 32 bytes)
GEMINI_API_KEY=
REDIS_URL=redis://redis:6379

# --- Bot de WhatsApp ---
WEBHOOK_SIGNATURE_KEY=     # HMAC do /webhook-whatsapp (padrão: API_SECRET_KEY)
BOT_WHATSAPP_URL=          # ex.: http://whatsapp-saas-bot:3000 (vazio = não envia mensagens)
BOT_SESSION_NAME=sessao-principal
BOT_SESSION_ID=            # opcional; vazio resolve pelo nome
BOT_API_KEY=               # chave do tenant no bot (X-API-Key)

# --- Google e serviços externos (opcionais) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://meu-financeiro-proxy.onrender.com/oauth2callback
WEATHER_API_KEY=
OPENROUTE_API_KEY=

# --- Só do .NET ---
JOBS_ENABLED=false         # true no servidor (Quartz roda no processo)
LOG_TO_FILE=false
LOG_DIR=
RATE_LIMIT_ENABLED=false
API_KEYS_ROUTES_ENABLED=false
