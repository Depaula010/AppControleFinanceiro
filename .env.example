# ============================================
# EXEMPLO DE CONFIGURAÇÃO - Meu Secretário API
# ============================================
# COPIE ESTE ARQUIVO PARA .env E CONFIGURE OS VALORES

# ============================================
# BANCO DE DADOS
# ============================================
DATABASE_URL=postgresql://usuario:senha@localhost:5432/nome_do_banco

# ============================================
# REDIS (Cache e Rate Limiting)
# ============================================
REDIS_URL=redis://localhost:6379

# ============================================
# API KEYS E SECRETS
# ============================================
# Chave secreta para endpoints administrativos
API_SECRET_KEY=sua_chave_secreta_super_segura_aqui

# Gemini AI
GEMINI_API_KEY=sua_gemini_api_key_aqui

# ============================================
# WHATSAPP
# ============================================
BOT_WHATSAPP_URL=http://localhost:3000/send-message

# ============================================
# GOOGLE CALENDAR OAUTH2
# ============================================
GOOGLE_CLIENT_ID=seu_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=sua_client_secret
GOOGLE_REDIRECT_URI=https://seu-backend.onrender.com/webhook-google-calendar

# ============================================
# SEGURANÇA - RATE LIMITING
# ============================================
# Habilitar rate limiting (recomendado: true)
RATELIMIT_ENABLED=true

# ============================================
# SEGURANÇA - HEADERS HTTP
# ============================================
# Habilitar headers de segurança (recomendado: true)
SECURITY_HEADERS_ENABLED=true

# ============================================
# SEGURANÇA - PROTEÇÃO CONTRA BOTS
# ============================================
# Habilitar proteção contra bots/scanners (recomendado: true)
BOT_PROTECTION_ENABLED=true

# Habilitar bloqueio automático de IPs suspeitos (recomendado: true)
AUTO_BLOCK_ENABLED=true

# Duração do bloqueio em minutos (padrão: 60)
BLOCK_DURATION_MINUTES=60

# Número de tentativas suspeitas antes de bloquear (padrão: 5)
MAX_SUSPICIOUS_ATTEMPTS=5

# ============================================
# SEGURANÇA - CRIPTOGRAFIA
# ============================================
# Chave de criptografia para dados sensíveis (API keys, tokens)
# IMPORTANTE: Gere uma chave única para produção!
# Como gerar: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Se não configurado, será derivada automaticamente da API_SECRET_KEY (não recomendado para produção)
# ENCRYPTION_KEY=sua_chave_fernet_aqui

# ============================================
# SEGURANÇA - CORS
# ============================================
# Habilitar CORS apenas se necessário (padrão: false)
CORS_ENABLED=false

# Origens permitidas (separadas por vírgula)
# CORS_ORIGINS=https://seudominio.com,https://app.seudominio.com

# ============================================
# LOGGING
# ============================================
# Arquivo de log de segurança
SECURITY_LOG_FILE=logs/security.log

# Nível de log (DEBUG, INFO, WARNING, ERROR, CRITICAL)
SECURITY_LOG_LEVEL=WARNING

# ============================================
# NOTAS IMPORTANTES
# ============================================
# 1. NUNCA commite o arquivo .env no Git
# 2. Use valores fortes para API_SECRET_KEY
# 3. Configure as mesmas variáveis no Render.com
# 4. Teste localmente antes de fazer deploy
