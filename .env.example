# ========================================
# EXEMPLO DE CONFIGURAÇÃO - AppControleFinanceiro
# ========================================
# IMPORTANTE: Copie este arquivo para .env e configure com valores reais
# NUNCA commit o arquivo .env no Git!

# ========== CHAVES DE SEGURANÇA ==========
# API_SECRET_KEY: Chave para autenticação de requisições do bot/automate
# IMPORTANTE: Deve ter pelo menos 32 caracteres
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_SECRET_KEY=GERAR_CHAVE_SEGURA_AQUI_32_CARACTERES_MINIMO

# WEBHOOK_SIGNATURE_KEY: Chave separada para assinatura HMAC dos webhooks
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(32))"
WEBHOOK_SIGNATURE_KEY=GERAR_OUTRA_CHAVE_DIFERENTE_AQUI

# ENCRYPTION_KEY: Chave dedicada para criptografar dados sensíveis (tokens OAuth, API keys)
# Gere com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=GERAR_CHAVE_FERNET_AQUI

# ========== BANCO DE DADOS ==========
# PostgreSQL connection string
# Formato: postgresql://usuario:senha@host:porta/database
DATABASE_URL=postgresql://usuario:senha_forte@localhost:5432/meu_secretario

# ========== APIs EXTERNAS ==========
# Google Gemini AI
GEMINI_API_KEY=SUA_CHAVE_GEMINI_AQUI

# Google Calendar OAuth (opcional - para integração com calendário)
GOOGLE_CLIENT_ID=seu-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=sua_client_secret
GOOGLE_REDIRECT_URI=https://seu-dominio.com/oauth2callback

# Gmail Push Notifications (opcional - para automação de emails PIX)
GCP_PROJECT_ID=seu-projeto-gcp
PUBSUB_TOPIC_NAME=gmail-push
PUBSUB_SUBSCRIPTION_NAME=gmail-push-subscription
GMAIL_USER_EMAIL=rafaeldepaulaextratos@gmail.com
GMAIL_PUSH_ENABLED=true
GMAIL_WATCH_RENEWAL_HOURS=24

# Weather API (opcional - para notificações meteorológicas)
WEATHER_API_KEY=sua_chave_weather_api

# ========== SERVIÇOS ==========
# URL do Bot WhatsApp
BOT_WHATSAPP_URL=http://localhost:3000

# Redis (cache e sessões)
REDIS_URL=redis://localhost:6379

# ========== SEGURANÇA (CORS) ==========
# Habilitar CORS apenas se necessário (frontend separado)
CORS_ENABLED=false

# Origens permitidas (separadas por vírgula, SEM wildcard *)
# Exemplo: CORS_ORIGINS=https://meuapp.com,https://app.meudominio.com
CORS_ORIGINS=

# ========== AMBIENTE ==========
# development | production
FLASK_ENV=development
FLASK_DEBUG=false
