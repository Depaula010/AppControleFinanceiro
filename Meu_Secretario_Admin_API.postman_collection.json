		{
			"name": "Testes & Debug",
			"item": [
				{
					"name": "Test Notification",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "x-api-key",
								"value": "{{API_SECRET_KEY}}",
								"type": "text"
							},
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"tipo\": \"agenda\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{BASE_URL}}/admin/test-notification",
							"host": ["{{BASE_URL}}"],
							"path": ["admin", "test-notification"]
						},
						"description": "Testa envio de notificações\n\nTipos:\n- agenda: Notificação de agenda do dia\n- bills: Notificação de contas a pagar"
					},
					"response": []
				},
