							}
						],
						"url": {
							"raw": "{{BASE_URL}}/admin/test-monthly-report/1?momento=INICIO_MES",
							"host": ["{{BASE_URL}}"],
							"path": ["admin", "test-monthly-report", "1"],
							"query": [
								{
									"key": "momento",
									"value": "INICIO_MES",
									"description": "INICIO_MES ou FIM_MES"
								}
							]
						},
						"description": "Testa envio de relatório mensal\n\nMomentos:\n- INICIO_MES\n- FIM_MES"
